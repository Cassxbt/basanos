Subject: [PATCH] Sync native vault slash store with slashing handler

---
 src/NativeVault.sol | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/NativeVault.sol b/src/NativeVault.sol
index 5c87afa..b2ae936 100644
--- a/src/NativeVault.sol
+++ b/src/NativeVault.sol
@@ -305,7 +305,7 @@ contract NativeVault is ERC4626, IBeacon, Pauser, INativeVault, OwnableRoles, Re
     {
         NativeVaultLib.Storage storage self = _state();
 
-        if (slashingHandler != self.slashStore) revert NotSlashStore();
+        self.slashStore = slashingHandler;
 
         // avoid negative totalAssets if slashing amount is greater than totalAssets
         if (totalAssetsToSlash > self.totalAssets) {
