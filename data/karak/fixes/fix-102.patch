From b23dac4d1f312d1f0136b5341886e68afee5b1c8 Mon Sep 17 00:00:00 2001
From: basanos-fixture <fixture@localhost>
Date: Sun, 15 Nov 2026 00:44:52 -0500
Subject: [PATCH] Sweep slashed ETH from credited node balance only

---
 src/NativeVault.sol | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/NativeVault.sol b/src/NativeVault.sol
index 5c87afa..dbe7047 100644
--- a/src/NativeVault.sol
+++ b/src/NativeVault.sol
@@ -429,14 +429,15 @@ contract NativeVault is ERC4626, IBeacon, Pauser, INativeVault, OwnableRoles, Re
         // slashed ETH = total restaked ETH (node + beacon) - share price equivalent ETH
         uint256 slashedAssets = node.totalRestakedETH - convertToAssets(balanceOf(nodeOwner));
 
-        // sweepable ETH = min(ETH available on node address, total slashed ETH)
-        uint256 slashedWithdrawable = Math.min(node.nodeAddress.balance, slashedAssets);
+        // sweepable ETH = min(credited ETH available on node address, total slashed ETH)
+        uint256 slashedWithdrawable = Math.min(node.withdrawableCreditedNodeETH, slashedAssets);
 
         // withdraw sweepable ETH to slashStore
         INativeNode(node.nodeAddress).withdraw(self.slashStore, slashedWithdrawable);
 
         // update total restaked ETH available (node + beacon)
         node.totalRestakedETH -= slashedWithdrawable;
+        node.withdrawableCreditedNodeETH -= slashedWithdrawable;
 
         // update withdrawable credited ETH available on the node only when node balance
         // decreases to less than that of the credited node ETH
